rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A student doc id bakes the pilot's secret code into an unguessable
    // hash — knowing the id IS the login. Listing is denied, so ids can't
    // be discovered.
    match /students/{id} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
    // Photo-homework diagnostics (event metadata only, never images) so
    // grown-ups can watch tests from the Firebase console.
    match /paperlog/{id} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
    // Name registry so the gate can say "wrong code" instead of silently
    // creating a duplicate pilot. Contains no secrets.
    match /names/{id} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
    // Teacher rosters. The doc id is a hash of a teacher code that is typed in
    // Teacher HQ and never stored in the app, so the roster is only reachable
    // by someone who knows that code. Listing stays denied, so rosters cannot
    // be discovered any more than student records can.
    match /rosters/{id} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
    // Question banks — the exercises themselves.
    //
    // Read is public and must be: every child's device fetches these.
    //
    // WRITES ARE DENIED TO CLIENTS ENTIRELY, and that is not laziness — it is
    // the only honest option here. Every other collection is protected by an
    // UNGUESSABLE DOC ID: knowing the id is the login, and `list` is denied so
    // ids cannot be discovered. Question-bank ids are NOT secret — "y3", "y5",
    // "la", "japan", named in the client source — so that protection does not
    // apply, and an `if true` write would let anyone who reads our JavaScript
    // replace every question a third-grader is served.
    //
    // A previous attempt required the write to name a roster document that
    // exists, on the theory that roster ids are a hash of the teacher code.
    // THAT WAS BROKEN: rosters allow `create: if true` with no id validation,
    // so an attacker creates rosters/<anything> in one request and uses it as
    // their own credential in the next. exists() proves a document is present,
    // never that whoever wrote it knew a secret. With no authentication in the
    // app, any proof a client can present, a client can manufacture.
    //
    // So publishing is an ADMIN operation: the Firebase console, or a script
    // holding service-account credentials, both of which bypass these rules.
    // That costs the browser-console publish path, which had no UI and no
    // callers. It does not cost the feature — banks still load from the DB, and
    // a question can still be fixed without shipping a build.
    //
    // If in-app publishing is ever wanted, the mechanism is a shared secret
    // compared against a literal IN THIS FILE — rules are server-side and are
    // never served to clients, so a hash placed here stays private in a way
    // nothing in index.html can.
    match /questionbanks/{id} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
    // Lessons — the slide walkthroughs, including the ones the tutor generates.
    //
    // Same shape of problem as questionbanks, so the same answer: read is
    // public because every device has to fetch them, and client writes are
    // denied because lesson bank ids are not secret either. A lesson is
    // teaching material a child reads; letting anyone overwrite it is worse
    // than letting them overwrite a question.
    //
    // This means a generated lesson cannot publish itself into the shared
    // bank. It does not have to: the round keeps its lesson inline in the
    // child's own record, so the child gets taught either way. Promoting a
    // lesson that worked into the shared pool — where other children reuse it
    // — is an admin step: Teacher HQ shows the lesson JSON, and the Firebase
    // console or a service-account script writes it.
    match /lessons/{id} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
  }
}
